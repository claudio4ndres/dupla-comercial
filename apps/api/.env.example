# Variables de entorno del backend (apps/api).
#
# Copia este archivo a `.env` y rellena los valores REALES. El `.env` está en
# .gitignore: NUNCA se commitea (regla de oro — cero secretos en el repo, las
# credenciales del LLM viven solo en el backend).
#
#   cp .env.example .env   # y edita los valores

# --- Claude / Anthropic (T7a) ---
# API key del backend para clasificar/resumir (Haiku) y conversar (Sonnet).
# Se obtiene en https://console.anthropic.com/ . Solo backend (regla de oro #3).
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase · Auth (T7b) ---
# Secreto JWT del proyecto: Dashboard → Project Settings → API → JWT Secret.
# Con él el backend verifica el token del usuario y extrae su `empresa_id`.
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
