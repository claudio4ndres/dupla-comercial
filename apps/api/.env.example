# Variables de entorno del backend (apps/api).
#
# Copia este archivo a `.env` y rellena los valores REALES. El `.env` está en
# .gitignore: NUNCA se commitea (regla de oro — cero secretos en el repo, las
# credenciales del LLM viven solo en el backend).
#
#   cp .env.example .env   # y edita los valores

# --- Claude / Anthropic (T7a) ---
# API key del backend para clasificar/resumir (Haiku) y conversar (Sonnet).
# Se obtiene en https://console.anthropic.com/ . Solo backend (regla de oro #3).
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase · Auth + datos (T7b/T7c) ---
# Dashboard → Project Settings → API. Con el JWT Secret el backend verifica el
# token del usuario y extrae su `empresa_id`; con URL + anon key el repo real
# pega a PostgREST a nombre del usuario (la RLS filtra por su empresa).
SUPABASE_JWT_SECRET=tu-jwt-secret-de-supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-publica

# --- Google OAuth · Gmail (TR1) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (tipo
# "Web application"). Activa la Gmail API. Con client_id+secret el backend
# refresca el access token de cada casilla y canjea el `code` del consentimiento.
# El redirect_uri debe coincidir EXACTO con el registrado en la consola y con el
# callback del backend (p.ej. https://tu-api/integraciones/correo/gmail/callback).
# Scope mínimo usado: gmail.readonly (solo lectura). Solo backend (regla de oro #3).
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REDIRECT_URI=https://tu-api/integraciones/correo/gmail/callback

# A dónde vuelve el navegador tras conectar el correo (la Bandeja del front). Es la
# `url_post_conexion` del OAuth: el callback redirige acá al terminar (p.ej.
# https://tu-front/bandeja).
FRONTEND_URL=https://tu-front/

# --- Supabase · service role (TR3 · poller y callback OAuth) ---
# Dashboard → Project Settings → API → `service_role` key. SALTA la RLS: la usan
# SOLO el poller (lo dispara Cloud Scheduler, sin JWT) y el callback de OAuth (es un
# redirect del navegador, sin header Authorization). Por eso esos caminos fijan
# `empresa_id` explícito en cada fila. JAMÁS exponer al front (regla de oro #3).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Google Secret Manager (TR2) ---
# Proyecto de GCP donde se guardan los refresh tokens de cada casilla (un secret por
# integración). El `token_ref` que persiste en `integraciones` es la ruta del secreto,
# nunca el token en claro (CA5). La service account de Cloud Run necesita el rol
# `Secret Manager Admin` (crear/leer/borrar versiones).
GCP_PROJECT_ID=tu-proyecto-gcp

# --- Poller interno (T12 · TR4) ---
# Secreto compartido que protege POST /interno/poller/correo. Cloud Scheduler lo manda
# en el header `X-Poller-Token`. Genera uno aleatorio largo (p.ej. `openssl rand -hex 32`).
# En producción puede reemplazarse por OIDC del propio Scheduler.
POLLER_TOKEN=genera-un-secreto-aleatorio-largo

# --- Almacén del state anti-CSRF del OAuth (spec 015) ---
# "supabase" (default, producción): el state vive en la tabla `estados_oauth`
# (sobrevive reinicios y funciona con varias instancias de Cloud Run).
# "memoria": dict del proceso, solo para desarrollo local de una instancia.
# ESTADO_OAUTH_BACKEND=memoria
